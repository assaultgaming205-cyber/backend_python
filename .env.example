# Travel Buddy Environment Configuration
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
APP_TIMEZONE=Asia/Kolkata

# --- AI Configuration (NVIDIA Nemotron) ---
AI_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TIMEOUT_MS=45000

# --- Voice Input (STT - NVIDIA Riva) ---
STT_ENABLED=true
STT_DEFAULT_LANGUAGE=auto

# --- Travel Providers ---
FLIGHT_PROVIDER=bankg
BANKG_BASE_URL=https://bankg-stagging-api.testuat.com/travel/v1/api
BANKG_GATEWAY_URL=https://bankg-stagging-api.testuat.com/travel/v1/api/travel-master/airSearch
# Non-negotiable safety gates: flightBook and submitAmendment are permanently disabled
ENABLE_FLIGHT_BOOK=false
ENABLE_AMENDMENT_SUBMIT=false
# Feature flag: disabled until provider clarifies pre/post payment timing
ENABLE_FARE_VALIDATE=false

HOTEL_PROVIDER=makemytrip
RAIL_PROVIDER=makemytrip
TRAVEL_API_ONLY=true
HOTEL_PHOTO_SOURCE=provider
PROVIDER_TIMEOUT_MS=25000
FLIGHT_PROVIDER_TIMEOUT_MS=25000

# --- MakeMyTrip Base URLs ---
MMT_RAILWAYS_BASE_URL=https://railways.makemytrip.com
MMT_RAILWAYS_ALTERNATE_BASE_URL=https://railways.makemytrip.com
MMT_FLIGHTS_BASE_URL=https://flights-cb.makemytrip.com/api/fareCalendar
MMT_HOTELS_BASE_URL=https://mapi.makemytrip.com/clientbackend/cg/search-hotels
MAKEMYTRIP_BASE_URL=https://railways.makemytrip.com
MMT_COOKIE=
MMT_DEVICE_ID=
MMT_RAIL_TRANSPORT=curl

# --- Voice Output (TTS - Sarvam AI) ---
TTS_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MEERA_SPEAKER=priya
SARVAM_KABIR_SPEAKER=aditya
